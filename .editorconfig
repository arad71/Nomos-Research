# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file

root = true
[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true
charset = utf-8

[*.{js,jsx,ts,tsx,json}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 88
profile = black

[*.{yml,yaml}]
indent_size = 2
