# This file contains overrides for environment variables defined in docker-compose.yml / docker-compose.override.yml
VERSION=staging
DB_USER=postgres
DB_PASSWORD=supersecret
DB_HOST=postgres
DB_PORT=5432
ADMIN_EMAIL=admin@taxman.com
ADMIN_PASSWORD=anothersupersecret
# Port that nginx gets published on
# Default: 8000
PUBLISH_PORT=80
# Set's the port used in docker-compose.override.yml. Use this to connect to the DB from your host.
DB_PUBLISH_PORT=5432
NODE_ENV=development
# Base URL this environment is available at.
# Default: http://localhost:8000
REACT_APP_BASE_URL=http://20.70.4.54
# Api path
# Default: http://localhost:8000/api/v1
REACT_APP_BACKEND_URL=http://20.70.4.54/api/v1